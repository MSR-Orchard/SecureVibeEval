# Pi CLI harness defaults to the localhost proxy on port 8080.
PI_PROVIDER=copilot_proxy
PI_MODEL=claude-opus-4.8
PI_PROXY_BASE_URL=http://127.0.0.1:8080
PI_API_KEY=proxy-handles-auth

# Optional: off, minimal, low, medium, high, or xhigh.
PI_THINKING=

# Optional: path to a models.json to copy into /root/.pi/agent/models.json
# during setup. Leave empty to use the built-in localhost proxy model list.
PI_MODELS_CONFIG=

# Disable Pi startup network checks during eval runs.
PI_OFFLINE=1
